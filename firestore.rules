rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function membershipId(leagueId) {
      return request.auth.uid + '_' + leagueId;
    }

    function isLeagueMember(leagueId) {
      return isSignedIn() &&
        (isAdmin() || exists(/databases/$(database)/documents/memberships/$(membershipId(leagueId))));
    }

    function isLeagueAdmin(leagueId) {
      return isAdmin() ||
        (isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.adminUids);
    }

    function isActiveSeason(leagueId, seasonId) {
      return isLeagueMember(leagueId) &&
        get(/databases/$(database)/documents/leagues/$(leagueId)).data.activeSeasonId == seasonId &&
        get(/databases/$(database)/documents/leagues/$(leagueId)/seasons/$(seasonId)).data.status == 'active';
    }

    match /leagues/{leagueId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.adminUids.size() == 1 &&
        request.auth.uid in request.resource.data.adminUids &&
        request.resource.data.activeSeasonId is string;
      allow update: if isLeagueAdmin(leagueId) &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.code == resource.data.code &&
        request.resource.data.adminUids == resource.data.adminUids &&
        request.resource.data.activeSeasonId == resource.data.activeSeasonId;
      allow delete: if isLeagueAdmin(leagueId);

      match /players/{id} {
        allow read: if isLeagueMember(leagueId);
        allow write: if isLeagueAdmin(leagueId);
      }

      match /seasons/{seasonId} {
        allow read: if isLeagueMember(leagueId);
        allow create: if isSignedIn() &&
          request.resource.data.leagueId == leagueId &&
          request.resource.data.status == 'active' &&
          getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.createdBy == request.auth.uid &&
          getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.activeSeasonId == seasonId;
        allow update: if isLeagueAdmin(leagueId) &&
          isActiveSeason(leagueId, seasonId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['matchCount']);
        allow delete: if false;

        match /matches/{id} {
          allow read: if isLeagueMember(leagueId);
          allow create, update, delete: if isLeagueAdmin(leagueId) &&
            isActiveSeason(leagueId, seasonId);
        }
      }

      match /history/{seasonId} {
        allow read: if isLeagueMember(leagueId);
        allow write: if false;
      }

      match /seasonOperations/{operationId} {
        allow read, write: if false;
      }

      match /config/{id} {
        allow read: if isLeagueMember(leagueId);
        allow write: if isLeagueAdmin(leagueId);
      }
    }

    match /leagueCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.leagueId is string &&
        getAfter(/databases/$(database)/documents/leagues/$(request.resource.data.leagueId)).data.createdBy == request.auth.uid &&
        getAfter(/databases/$(database)/documents/leagues/$(request.resource.data.leagueId)).data.code == code;
      allow update, delete: if false;
    }

    match /memberships/{membershipId} {
      allow read: if isSignedIn() &&
        (membershipId.startsWith(request.auth.uid + '_') ||
          resource.data.uid == request.auth.uid ||
          isLeagueAdmin(resource.data.leagueId));
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        membershipId == request.resource.data.uid + '_' + request.resource.data.leagueId &&
        ((request.resource.data.role == 'player' &&
          request.resource.data.joinCode is string &&
          exists(/databases/$(database)/documents/leagueCodes/$(request.resource.data.joinCode)) &&
          get(/databases/$(database)/documents/leagueCodes/$(request.resource.data.joinCode)).data.leagueId == request.resource.data.leagueId) ||
        (request.resource.data.role == 'admin' &&
          getAfter(/databases/$(database)/documents/leagues/$(request.resource.data.leagueId)).data.createdBy == request.auth.uid));
      allow update, delete: if isLeagueAdmin(resource.data.leagueId);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && userId == request.auth.uid;
      allow create: if isSignedIn() &&
        userId == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role == 'player';
      allow update: if isSignedIn() &&
        userId == request.auth.uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.role == 'player';
      allow delete: if false;
    }

    match /admins/{id} {
      allow read: if isSignedIn() && (id == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
